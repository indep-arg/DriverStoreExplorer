<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rapr.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rapr.WinUI">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar with the menu in it, as in the sketches. -->
        <Grid x:Name="AppTitleBar" Height="48" ColumnSpacing="12" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///icon.ico" />
            <TextBlock x:Name="WindowTitle" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
            <MenuBar x:Name="MainMenu" Grid.Column="2" VerticalAlignment="Center">
                <MenuBarItem x:Name="FileMenu">
                    <MenuFlyoutItem x:Name="ChooseStoreItem" Click="ChooseStore_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDA2;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ExportListItem" Click="ExportList_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F9;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ExitItem" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem x:Name="OptionsMenu">
                    <MenuFlyoutSubItem x:Name="BackendMenu">
                        <RadioMenuFlyoutItem x:Name="NativeBackendItem" GroupName="Backend" Tag="Native" Click="Backend_Click" />
                        <RadioMenuFlyoutItem x:Name="DismBackendItem" GroupName="Backend" Tag="DISM" Click="Backend_Click" />
                        <RadioMenuFlyoutItem x:Name="PnpUtilBackendItem" GroupName="Backend" Tag="PnpUtil" Click="Backend_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="LayoutMenu">
                        <RadioMenuFlyoutItem x:Name="ExplorerLayoutItem" GroupName="Layout" Tag="Explorer" Click="Layout_Click" />
                        <RadioMenuFlyoutItem x:Name="CompactLayoutItem" GroupName="Layout" Tag="Compact" Click="Layout_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="ThemeMenu">
                        <RadioMenuFlyoutItem x:Name="SystemThemeItem" GroupName="Theme" Tag="System" Click="Theme_Click" />
                        <RadioMenuFlyoutItem x:Name="LightThemeItem" GroupName="Theme" Tag="Light" Click="Theme_Click" />
                        <RadioMenuFlyoutItem x:Name="DarkThemeItem" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <MenuBarItem x:Name="LanguageMenu" />
                <MenuBarItem x:Name="HelpMenu">
                    <MenuFlyoutItem x:Name="AboutItem" Click="About_Click" />
                </MenuBarItem>
            </MenuBar>
        </Grid>

        <!-- Commands and search. -->
        <Grid Grid.Row="1" Padding="8,0,16,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar x:Name="Commands" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
                <AppBarButton x:Name="RefreshButton" Click="Refresh_Click">
                    <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="AddButton" Click="Add_Click">
                    <AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="SelectOldButton" Click="SelectOld_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE81C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="ExportAllButton" Click="ExportAll_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="320" VerticalAlignment="Center" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- A · Explorer with a details pane -->
        <Grid x:Name="ExplorerLayout" Grid.Row="2" Padding="8,0,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4" Padding="0,4,0,8">
                    <TextBlock x:Name="ViewsHeader" Margin="12,0,0,4" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="ViewsList" SelectionMode="Single" ItemContainerStyle="{StaticResource NavigationRowStyle}" SelectionChanged="Navigation_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavigationItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Text}" ToolTipService.ToolTip="{x:Bind Text}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CountText}" Style="{StaticResource CellTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ClassesHeader" Margin="12,16,0,4" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="ClassesList" SelectionMode="Single" ItemContainerStyle="{StaticResource NavigationRowStyle}" SelectionChanged="Navigation_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavigationItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Text}" ToolTipService.ToolTip="{x:Bind Text}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CountText}" Style="{StaticResource CellTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- The list -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="20,14,20,10" Spacing="2">
                        <TextBlock x:Name="ExplorerTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ExplorerSummary" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Padding="12,6,12,6" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ExplorerCheckAll" MinWidth="0" Padding="0" Click="CheckAll_Click" />
                        <Button x:Name="ExplorerInfHeader" Grid.Column="1" Tag="Inf" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="ExplorerProviderHeader" Grid.Column="2" Tag="Provider" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="ExplorerVersionHeader" Grid.Column="3" Tag="Version" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="ExplorerDateHeader" Grid.Column="4" Tag="Date" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="ExplorerSizeHeader" Grid.Column="5" Tag="Size" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" HorizontalContentAlignment="Right" Margin="0,0,12,0" />
                        <Button x:Name="ExplorerDeviceHeader" Grid.Column="6" Tag="Device" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                    </Grid>
                    <ListView x:Name="ExplorerList" Grid.Row="2" SelectionMode="Single" ItemContainerStyle="{StaticResource PackageRowStyle}"
                              SelectionChanged="ExplorerList_SelectionChanged" Padding="0,4,0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DriverRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Inf}" />
                                    <local:TrailingTagPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="{x:Bind Inf}" ToolTipService.ToolTip="{x:Bind Inf}" Style="{StaticResource CellTextStyle}" />
                                        <Border Style="{StaticResource TagBorderStyle}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind OlderTagVisibility}">
                                            <TextBlock Text="{x:Bind OlderTagText}" Style="{StaticResource TagTextStyle}" />
                                        </Border>
                                    </local:TrailingTagPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Provider}" ToolTipService.ToolTip="{x:Bind Provider}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Version}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Date}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Size}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Device}" ToolTipService.ToolTip="{x:Bind Device}" Style="{StaticResource CellTextStyle}" Opacity="{x:Bind DeviceOpacity}" FontStyle="{x:Bind DeviceFontStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ExplorerEmpty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Details of the selected package -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <StackPanel x:Name="DetailsEmptyPanel" Margin="24" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontSize="48" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                        <TextBlock x:Name="DetailsEmpty" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Padding="20" Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="DetailsTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                    <Border x:Name="DetailsOlderTag" Style="{StaticResource TagBorderStyle}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                        <TextBlock x:Name="DetailsOlderTagText" Style="{StaticResource TagTextStyle}" />
                                    </Border>
                                    <Border x:Name="DetailsNoDeviceTag" Style="{StaticResource TagBorderStyle}" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <TextBlock x:Name="DetailsNoDeviceTagText" Style="{StaticResource TagTextStyle}" />
                                    </Border>
                                    <Border x:Name="DetailsBootCriticalTag" Style="{StaticResource TagBorderStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                                        <TextBlock x:Name="DetailsBootCriticalTagText" Style="{StaticResource TagTextStyle}" />
                                    </Border>
                                    <Border x:Name="DetailsExtensionTag" Style="{StaticResource TagBorderStyle}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                        <TextBlock x:Name="DetailsExtensionTagText" Style="{StaticResource TagTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="DetailsNotes" TextWrapping="Wrap" />
                            <ItemsControl x:Name="DetailsFields">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DetailField">
                                        <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="12" Margin="0,-8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailsFolderLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="DetailsFolderLink" Grid.Column="1" Padding="0" Click="DetailsFolder_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DetailsExportButton" Click="DetailsExport_Click" />
                                <Button x:Name="DetailsDeleteButton" Click="DetailsDelete_Click" Style="{StaticResource DangerButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- C · Compact list with a selection bar -->
        <Grid x:Name="CompactLayout" Grid.Row="2" Padding="16,0,16,8" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="ChipPanel" Orientation="Horizontal" Spacing="8" Padding="0,4,0,4" />

            <Border x:Name="CompactListCard" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,8,12,8" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CompactCheckAll" MinWidth="0" Padding="0" Click="CheckAll_Click" />
                        <Button x:Name="CompactInfHeader" Grid.Column="1" Tag="Inf" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="CompactClassHeader" Grid.Column="2" Tag="Class" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="CompactProviderHeader" Grid.Column="3" Tag="Provider" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="CompactVersionHeader" Grid.Column="4" Tag="Version" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="CompactDateHeader" Grid.Column="5" Tag="Date" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="CompactSizeHeader" Grid.Column="6" Tag="Size" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" HorizontalContentAlignment="Right" Margin="0,0,12,0" />
                        <Button x:Name="CompactDeviceHeader" Grid.Column="7" Tag="Device" Click="SortHeader_Click" Style="{StaticResource HeaderButtonStyle}" />
                    </Grid>
                    <ListView x:Name="CompactList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CompactList_ItemClick"
                              ItemContainerStyle="{StaticResource PackageRowStyle}" Padding="0,4,0,88">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DriverRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Checked rows are tinted with the accent color. -->
                                    <Border Grid.ColumnSpan="8" Margin="-12,0,-12,0" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind CheckedTint, Mode=OneWay}" />
                                    <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Inf}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Inf}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind DriverClass}" ToolTipService.ToolTip="{x:Bind DriverClass}" Style="{StaticResource CellTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Provider}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Version}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Date}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Size}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind Device}" ToolTipService.ToolTip="{x:Bind Device}" Style="{StaticResource CellTextStyle}" Opacity="{x:Bind DeviceOpacity}" FontStyle="{x:Bind DeviceFontStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="CompactEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Floating bar for the checked packages -->
            <Border x:Name="SelectionBar" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    Padding="18,10,12,10" CornerRadius="10" Translation="0,0,32" Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                <Border.Shadow>
                    <ThemeShadow x:Name="SelectionBarShadow" />
                </Border.Shadow>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectionDetail" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Rectangle Width="1" Height="22" Margin="4,0,4,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button x:Name="SelectionExportButton" Click="SelectionExport_Click" />
                    <Button x:Name="SelectionDeleteButton" Click="SelectionDelete_Click" Style="{StaticResource DangerButtonStyle}" />
                    <Button x:Name="SelectionClearButton" Click="SelectionClear_Click" Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" Padding="20,4,20,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="140" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="BackendText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
